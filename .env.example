# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional public support address. When blank, contact links point to the
# project's GitHub issue tracker instead of inventing an address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Session signing
# Signs the account session cookie.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# MongoDB
# Copy this file to .env.local and fill in your own Atlas/local connection string.
MONGODB_URI=
# Optional override; the data layer defaults to campus_cart.
MONGODB_DB=campus_cart

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI listing assist (OpenRouter)
# Get a key at https://openrouter.ai/keys. Optional; if unset, AI assist buttons are disabled.
OPENROUTER_API_KEY=
# Optional model override, e.g. openai/gpt-4o-mini. Defaults to baidu/ernie-5.5-flash-preview:free.
OPENROUTER_MODEL=
